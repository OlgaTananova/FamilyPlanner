# Stage 1: Install dependencies
FROM node:22-alpine AS deps

RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY frontend/web-app/package.json frontend/web-app/package-lock.json ./

RUN npm ci


# Stage 2: Build Next.js application
FROM node:22-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/web-app ./

ARG NEXT_PUBLIC_AZURE_AD_B2C_CLIENT_ID
ARG NEXT_PUBLIC_AZURE_AD_B2C_TENANT_NAME
ARG NEXT_PUBLIC_AZURE_AD_B2C_USER_FLOW
ARG NEXT_PUBLIC_AZURE_AD_B2C_PROFILE_EDIT_FLOW
ARG NEXT_PUBLIC_AZURE_AD_B2C_CATALOG_WRITE_SCOPE
ARG NEXT_PUBLIC_AZURE_AD_B2C_CATALOG_READ_SCOPE
ARG NEXT_PUBLIC_AZURE_AD_B2C_SHOPLIST_READ_SCOPE
ARG NEXT_PUBLIC_AZURE_AD_B2C_SHOPLIST_WRITE_SCOPE
ARG NEXT_PUBLIC_AZURE_AD_B2C_REDIRECT_URI
ARG NEXT_PUBLIC_AZURE_AD_B2C_EDIT_PROFILE_REDIRECT_URI
ARG NEXT_PUBLIC_GATEWAY_URL

ENV NEXT_PUBLIC_AZURE_AD_B2C_CLIENT_ID=$NEXT_PUBLIC_AZURE_AD_B2C_CLIENT_ID
ENV NEXT_PUBLIC_AZURE_AD_B2C_TENANT_NAME=$NEXT_PUBLIC_AZURE_AD_B2C_TENANT_NAME
ENV NEXT_PUBLIC_AZURE_AD_B2C_USER_FLOW=$NEXT_PUBLIC_AZURE_AD_B2C_USER_FLOW
ENV NEXT_PUBLIC_AZURE_AD_B2C_PROFILE_EDIT_FLOW=$NEXT_PUBLIC_AZURE_AD_B2C_PROFILE_EDIT_FLOW
ENV NEXT_PUBLIC_AZURE_AD_B2C_CATALOG_WRITE_SCOPE=$NEXT_PUBLIC_AZURE_AD_B2C_CATALOG_WRITE_SCOPE
ENV NEXT_PUBLIC_AZURE_AD_B2C_CATALOG_READ_SCOPE=$NEXT_PUBLIC_AZURE_AD_B2C_CATALOG_READ_SCOPE
ENV NEXT_PUBLIC_AZURE_AD_B2C_SHOPLIST_READ_SCOPE=$NEXT_PUBLIC_AZURE_AD_B2C_SHOPLIST_READ_SCOPE
ENV NEXT_PUBLIC_AZURE_AD_B2C_SHOPLIST_WRITE_SCOPE=$NEXT_PUBLIC_AZURE_AD_B2C_SHOPLIST_WRITE_SCOPE
ENV NEXT_PUBLIC_AZURE_AD_B2C_REDIRECT_URI=$NEXT_PUBLIC_AZURE_AD_B2C_REDIRECT_URI
ENV NEXT_PUBLIC_AZURE_AD_B2C_EDIT_PROFILE_REDIRECT_URI=$NEXT_PUBLIC_AZURE_AD_B2C_EDIT_PROFILE_REDIRECT_URI
ENV NEXT_PUBLIC_GATEWAY_URL=$NEXT_PUBLIC_GATEWAY_URL

ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# Stage 3: Production image
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
